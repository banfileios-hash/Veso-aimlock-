    "warning": {
        "description": "This configuration file is for educational and research purposes only",
        "risk": "May result in account ban if used in official game servers",
        "recommendation": "Only use in training ground or private servers"
    },
    
    "log_config": {
        "enable_log": true,
        "log_path": "/sdcard/aimlock_log.txt",
        "log_target": true,
        "log_position": true,
        "log_time": true
    }
