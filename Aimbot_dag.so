    printf("\n");
    printf("========================================\n");
    printf("  AIMLOCK CRT - Free Fire Headshot\n");
    printf("  Author: palofsc\n");
    printf("  Version: 3.0.0\n");
    printf("========================================\n");
    printf("\n");
}

void printHelp() {
    printf("Hotkeys:\n");
    printf("  F1 - Toggle Aimlock\n");
    printf("  F2 - Switch Aim Mode\n");
    printf("  F3 - Toggle FOV\n");
    printf("  Ctrl+C - Exit\n");
    printf("\n");
}

int main(int argc, char** argv) {
    signal(SIGINT, signal_handler);
    
    printBanner();
    loadConfig();
    printHelp();
    
    printf("[INFO] Dang tim process Free Fire...\n");
    g_pid = findProcess("com.dts.freefireth");
    
    if (g_pid == 0) {
        g_pid = findProcess("freefire");
    }
    
    if (g_pid == 0) {
        printf("[ERROR] Khong tim thay Free Fire process\n");
        printf("[INFO] Thu chay voi quyen root: sudo ./aimlock\n");
        return 1;
    }
    
    printf("[INFO] Da tim thay Free Fire (PID: %d)\n", g_pid);
    
    g_memory.playerPosition.x = 0;
    g_memory.playerPosition.y = 0;
    g_memory.playerPosition.z = 0;
    g_currentAngle.x = 0;
    g_currentAngle.y = 0;
    g_lastValidAngle = g_currentAngle;
    
    pthread_t thread;
    pthread_create(&thread, NULL, aimlockThread, NULL);
    
    printf("[INFO] Aimlock da san sang!\n");
    printf("[INFO] Nhan F1 de bat/tat\n");
    printf("\n");
    
    char ch;
    while (g_running) {
        ch = getchar();
        if (ch == 0x1B) {
            g_running = 0;
            break;
        }
    }
    
    g_running = 0;
    pthread_join(thread, NULL);
    
    printf("[INFO] Da dung aimlock\n");
    return 0;
}
