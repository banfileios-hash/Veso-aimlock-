            "low_hp": 1.0
        }
    },
    
    "bullet_config": {
        "accuracy": 1.0,
        "spread": 0.0,
        "error": 0.0,
        "deviation": 0.0,
        "bullet_speed": 1.5,
        "max_distance": 500.0
    },
    
    "memory_address": {
        "camera_angle": "0x7F8A4C08",
        "player_position": "0x7F8A4C00",
        "enemy_list": "0x7F8A4D00",
        "target_angle": "0x7F8A4C10",
        "smoothness": "0x7F8A4C14",
        "aimlock_status": "0x7F8A4C18",
        "current_target": "0x7F8A4C1C",
        "current_fov": "0x7F8A4C20"
    },
    
    "hotkey_config": {
        "aim_lock": "BUTTON_RIGHT",
        "switch_target": "KEY_TAB",
        "toggle_aimlock": "KEY_F1",
        "switch_aim_mode": "KEY_F2",
        "dagger_auto": "KEY_F3"
