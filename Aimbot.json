{
    "mod_name": "Aimlock Head + Dagger",
    "version": "2.1.0",
    "author": "palofsc",
    "description": "Aimlock head and dagger configuration for Free Fire",
    
    "aimlock_config": {
        "enable": true,
        "fov": 120.0,
        "smoothness": 0.35,
        "smoothness_when_swipe": 0.55,
        "aim_mode": "head",
        "priority": {
            "nearest": 1.0,
            "in_fov": 0.9,
            "moving": 0.7,
            "standing": 0.5
        },
        "target": {
            "head": {
                "enable": true,
                "offset": 0.0,
                "accuracy": 1.0,
                "priority": 1.0
            },
            "chest": {
                "enable": false,
                "offset": 0.0,
                "accuracy": 0.8,
                "priority": 0.5
            },
            "leg": {
                "enable": false,
                "offset": 0.0,
                "accuracy": 0.6,
                "priority": 0.3
            }
        },
        "aim_conditions": {
            "min_distance": 5.0,
            "max_distance": 300.0,
